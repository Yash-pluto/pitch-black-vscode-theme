{
  "name": "Pitch Black",
  "type": "dark",
  "semanticHighlighting": false,
  "colors": {
    "editor.background": "#000000",
    "sideBar.background": "#000000",
    "activityBar.background": "#000000",
    "titleBar.activeBackground": "#000000",
    "titleBar.inactiveBackground": "#000000",
    "statusBar.background": "#000000",
    "statusBar.noFolderBackground": "#000000",
    "terminal.background": "#000000",
    "panel.background": "#000000",
    "editorGroupHeader.tabsBackground": "#000000",
    "editorGroupHeader.noTabsBackground": "#000000",
    "tab.activeBackground": "#000000",
    "tab.inactiveBackground": "#000000",
    "tab.unfocusedActiveBackground": "#000000",
    "tab.unfocusedInactiveBackground": "#000000",
    "tab.border": "#000000",
    "tab.activeBorder": "#000000",
    "breadcrumb.background": "#000000",
    "editorGroup.border": "#000000",
    "editor.foreground": "#E2E8F0",
    "editorCursor.foreground": "#38BDF8",
    "editorLineNumber.foreground": "#333333",
    "editorLineNumber.activeForeground": "#94A3B8",
    "editor.selectionBackground": "#1E293B",
    "editor.lineHighlightBackground": "#0A0A0A",

    "editorBracketHighlight.foreground1": "#FBBF24",
    "editorBracketHighlight.foreground2": "#FF79C6",
    "editorBracketHighlight.foreground3": "#4EC9B0",
    "editorBracketHighlight.foreground4": "#BD93F9",
    "editorBracketHighlight.foreground5": "#A6E22E",
    "editorBracketHighlight.foreground6": "#38BDF8",
    "editorBracketHighlight.unexpectedBracket.foreground": "#FF0000"
  },
  "tokenColors": [
    {
      "name": "Comments",
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": {
        "foreground": "#52525B",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keywords, Storage, and Control",
      "scope": ["keyword", "storage", "control", "conditional"],
      "settings": {
        "foreground": "#C678DD",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Variables and Parameters",
      "scope": [
        "variable",
        "variable.other",
        "variable.language",
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#9CDCFE"
      }
    },
    {
      "name": "Functions and Methods",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call"
      ],
      "settings": {
        "foreground": "#0EA5E9"
      }
    },
    {
      "name": "Strings",
      "scope": ["string", "punctuation.definition.string"],
      "settings": {
        "foreground": "#86EFAC"
      }
    },
    {
      "name": "Numbers and Booleans",
      "scope": ["constant.numeric", "constant.language.boolean"],
      "settings": {
        "foreground": "#FBBF24"
      }
    },
    {
      "name": "Classes and Types",
      "scope": ["entity.name.type", "entity.name.class", "support.type"],
      "settings": {
        "foreground": "#F472B6"
      }
    },
    {
      "name": "Operators",
      "scope": ["keyword.operator"],
      "settings": {
        "foreground": "#FF79C6"
      }
    },
    {
      "name": "Punctuation",
      "scope": ["punctuation", "punctuation.separator"],
      "settings": {
        "foreground": "#64748B"
      }
    },
    {
      "name": "HTML/JSX/XML Tags",
      "scope": ["entity.name.tag", "meta.tag.sgml"],
      "settings": {
        "foreground": "#569CD6"
      }
    },
    {
      "name": "HTML/JSX/XML Attributes",
      "scope": ["entity.other.attribute-name"],
      "settings": {
        "foreground": "#9CDCFE",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Tag Brackets",
      "scope": ["punctuation.definition.tag"],
      "settings": {
        "foreground": "#64748B"
      }
    },
    {
      "name": "React Custom Components",
      "scope": ["support.class.component"],
      "settings": {
        "foreground": "#38BDF8",
        "fontStyle": "bold"
      }
    },
    {
      "name": "CSS/SCSS Properties",
      "scope": ["support.type.property-name", "meta.property-name"],
      "settings": {
        "foreground": "#38BDF8"
      }
    }
  ]
}
