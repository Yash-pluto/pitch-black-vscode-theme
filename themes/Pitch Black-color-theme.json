{
  "name": "Pitch Black",
  "type": "dark",
  "semanticHighlighting": false,
  "colors": {
    "editor.background": "#000000",
    "sideBar.background": "#000000",
    "activityBar.background": "#000000",
    "titleBar.activeBackground": "#000000",
    "titleBar.inactiveBackground": "#000000",
    "statusBar.background": "#000000",
    "statusBar.noFolderBackground": "#000000",
    "terminal.background": "#000000",
    "panel.background": "#000000",
    "editorGroupHeader.tabsBackground": "#000000",
    "editorGroupHeader.noTabsBackground": "#000000",
    "tab.activeBackground": "#000000",
    "tab.inactiveBackground": "#000000",
    "tab.unfocusedActiveBackground": "#000000",
    "tab.unfocusedInactiveBackground": "#000000",
    "tab.border": "#000000",
    "tab.activeBorder": "#000000",
    "breadcrumb.background": "#000000",
    "editorGroup.border": "#000000",
    "editor.foreground": "#E2E8F0",
    "editorCursor.foreground": "#38BDF8",
    "editorLineNumber.foreground": "#333333",
    "editorLineNumber.activeForeground": "#94A3B8",
    "editor.selectionBackground": "#1E293B",
    "editor.lineHighlightBackground": "#0A0A0A",

    "editorBracketHighlight.foreground1": "#FBBF24",
    "editorBracketHighlight.foreground2": "#FF79C6",
    "editorBracketHighlight.foreground3": "#4EC9B0",
    "editorBracketHighlight.foreground4": "#BD93F9",
    "editorBracketHighlight.foreground5": "#A6E22E",
    "editorBracketHighlight.foreground6": "#38BDF8",
    "editorBracketHighlight.unexpectedBracket.foreground": "#FF0000"
  },
  "tokenColors": [
    {
      "name": "Comments",
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": {
        "foreground": "#A6E22E",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Strings (No Orange/Red)",
      "scope": ["string", "punctuation.definition.string"],
      "settings": {
        "foreground": "#F1FA8C"
      }
    },
    {
      "name": "Decorator @ Symbol (White)",
      "scope": ["punctuation.decorator"],
      "settings": {
        "foreground": "#FFFFFF",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Decorator Function Name (Light Yellow)",
      "scope": [
        "meta.decorator variable.other.readwrite",
        "meta.decorator entity.name.function",
        "meta.decorator"
      ],
      "settings": {
        "foreground": "#FCE762"
      }
    },
    {
      "name": "Control Keywords (Pink: export, if, return, const)",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.control.export",
        "keyword.control.default",
        "storage.type",
        "conditional"
      ],
      "settings": {
        "foreground": "#FF79C6",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Storage Type Class (Blue)",
      "scope": [
        "storage.type.class",
        "storage.type.interface",
        "storage.type.type"
      ],
      "settings": {
        "foreground": "#38BDF8",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Modifiers (Blue: private, readonly, public)",
      "scope": ["storage.modifier"],
      "settings": {
        "foreground": "#38BDF8"
      }
    },
    {
      "name": "Class and Type Names (Turquoise)",
      "scope": ["entity.name.class", "entity.name.type", "support.class"],
      "settings": {
        "foreground": "#4EC9B0"
      }
    },
    {
      "name": "Variables and Properties (Blue: logger, etc)",
      "scope": [
        "variable",
        "variable.other.property",
        "variable.object.property",
        "meta.definition.variable",
        "support.variable"
      ],
      "settings": {
        "foreground": "#38BDF8"
      }
    },
    {
      "name": "Functions and Methods (Cyan)",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call"
      ],
      "settings": {
        "foreground": "#61AFEF"
      }
    },
    {
      "name": "Object Keys (Mint Green)",
      "scope": [
        "meta.object-literal.key",
        "support.type.property-name",
        "entity.name.tag.yaml"
      ],
      "settings": {
        "foreground": "#4ADE80"
      }
    },
    {
      "name": "Numbers and Booleans (Purple)",
      "scope": ["constant.numeric", "constant.language.boolean"],
      "settings": {
        "foreground": "#BD93F9"
      }
    },
    {
      "name": "Operators (Light Grey)",
      "scope": ["keyword.operator"],
      "settings": {
        "foreground": "#D4D4D4"
      }
    },
    {
      "name": "HTML/JSX Tags",
      "scope": ["entity.name.tag", "meta.tag.sgml"],
      "settings": {
        "foreground": "#61AFEF"
      }
    },
    {
      "name": "HTML/JSX Attributes",
      "scope": ["entity.other.attribute-name"],
      "settings": {
        "foreground": "#4ADE80",
        "fontStyle": "italic"
      }
    }
  ]
}
